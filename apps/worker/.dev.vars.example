# Worker application settings.
APP_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Facebook connection settings.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=choose-a-long-random-value
# Generate a base64-encoded 32-byte AES key for Page-token encryption.
TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# AI settings. Keep the API key as a local secret. Set the region/workspace URL.
AI_BASE_URL=
AI_API_KEY=your-alibaba-api-key
EMBEDDING_PROVIDER=alibaba
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1536
LLM_PROVIDER=alibaba
LLM_MODEL=qwen3.8-flash
AI_RETRIEVAL_MAX_DISTANCE=0.35
AI_DEBOUNCE_SECONDS=2
# Exact trusted public HTTPS origins, JSON array. Empty disables external tool egress.
AI_TOOL_ALLOWED_ORIGINS=[]
