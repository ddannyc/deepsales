# Worker application settings.
APP_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Facebook M0 settings retained until T04 replaces the fixed reply.
# Setup reference only; the Worker does not read META_APP_ID.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=choose-a-long-random-value
META_PAGE_ID=your-facebook-page-id
META_PAGE_ACCESS_TOKEN=your-page-access-token
