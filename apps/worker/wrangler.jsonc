{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "deepsales",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"assets": {
		"directory": "../web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/webhooks/*",
			"/health",
			"/ready"
		]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "REDACTED_HYPERDRIVE_ID"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "WEBHOOKS_QUEUE",
				"queue": "deepsales-webhooks"
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "deepsales-outbound"
			},
			{
				"binding": "AI_QUEUE",
				"queue": "deepsales-ai"
			},
			{
				"binding": "DOCUMENTS_QUEUE",
				"queue": "deepsales-documents"
			},
			{
				"binding": "MAINTENANCE_QUEUE",
				"queue": "deepsales-maintenance"
			}
		],
		"consumers": [
			{
				"queue": "deepsales-webhooks",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "deepsales-dlq"
			},
			{
				"queue": "deepsales-outbound",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "deepsales-dlq"
			},
			{
				"queue": "deepsales-ai",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "deepsales-dlq"
			},
			{
				"queue": "deepsales-documents",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "deepsales-dlq"
			},
			{
				"queue": "deepsales-maintenance",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "deepsales-dlq"
			}
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "WORKSPACE_REALTIME",
				"class_name": "WorkspaceRealtime"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "OBJECTS",
			"bucket_name": "deepsales-objects"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"WorkspaceRealtime"
			]
		}
	],
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"META_APP_ID": "REDACTED_META_APP_ID",
		"META_GRAPH_API_VERSION": "v26.0",
		"AI_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
		"EMBEDDING_PROVIDER": "alibaba",
		"EMBEDDING_MODEL": "qwen3.7-text-embedding",
		"EMBEDDING_DIMENSIONS": "1536",
		"LLM_PROVIDER": "alibaba",
		"LLM_MODEL": "qwen3.7-flash",
		"AI_RETRIEVAL_MAX_DISTANCE": "0.35"
	}
}