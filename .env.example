# Copy this file to .env.local for development, .env.test for tests, or .env.production.local for production migrations.
# Use .env.test.local instead when the test credentials are developer-specific.
# APP_ENV selects which file the shared config loader reads.
DATABASE_URL=postgresql://user:password@localhost:5432/deepsales

# AI settings used by local tooling or Worker overrides.
AI_BASE_URL=
AI_API_KEY=your-alibaba-api-key
EMBEDDING_PROVIDER=alibaba
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1536
LLM_PROVIDER=alibaba
LLM_MODEL=qwen3.8-flash
